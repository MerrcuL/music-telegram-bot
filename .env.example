# ==============================================================================
# Telegram Music Bot - Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# Telegram Bot Token obtained from @BotFather (Required)
TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram User IDs allowed to use the bot (Required)
ALLOWED_USERS=123456789,987654321

# Telegram Chat/Channel ID for caching audio files (Required for inline mode)
# Typically a negative number for supergroups or channels, e.g. -1001234567890
DUMP_CHAT_ID=-1001234567890


# Optional: Genius API Access Token for high-res cover art, Apple Music matching, and lyrics
GENIUS_ACCESS_TOKEN=

# Spotify API credentials - needed for the Spotify link button under tracks.
# Create an app at https://developer.spotify.com/dashboard to get them.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm API key - needed for the last.fm integration (/now and inline "now playing").
# Get one at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional: audio format of downloaded tracks.
#   m4a (default) - keeps YouTube's AAC audio as-is: no re-encoding, smallest files
#   mp3           - re-encodes everything to 192 kbps MP3 (slower, ~1/3 bigger files)
#   opus          - no re-encoding (faster), but Telegram treats these files as voice
#                   messages and refuses them for users who restrict voice messages
AUDIO_FORMAT=m4a

# Optional: URL of the bgutil PO token server (brainicism/bgutil-ytdlp-pot-provider
# Docker container). PO tokens make YouTube's "confirm you're not a bot" checks rarer.
# Default: http://127.0.0.1:4416 (container on the same host with port 4416 published)
BGUTIL_URL=http://127.0.0.1:4416
